    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "open-cli": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
